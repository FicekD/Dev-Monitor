<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource TextFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.group">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.numeral">
    <Setter Property="FontFamily" Value="{DynamicResource NumeralFont}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector="TextBlock.figure">
    <Setter Property="FontFamily" Value="{DynamicResource NumeralFont}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector="TextBlock.unit">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
  </Style>

  <Style Selector="Path.icon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stroke" Value="{DynamicResource InkMutedBrush}" />
  </Style>
  <Style Selector="Path.icon.small">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>

  <Style Selector="Border.sheet">
    <Setter Property="Background" Value="{DynamicResource SheetBrush}" />
    <Setter Property="CornerRadius" Value="12,0,0,0" />
  </Style>
  <Style Selector="Border.rule">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource RuleBrush}" />
  </Style>

  <Style Selector="StackPanel.page">
    <Setter Property="Margin" Value="40,32,40,40" />
    <Setter Property="Spacing" Value="36" />
    <Setter Property="MaxWidth" Value="{DynamicResource ContentMaxWidth}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="StackPanel.rows">
    <Setter Property="Spacing" Value="4" />
  </Style>

  <Style Selector="ListBox.segmented">
    <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="ItemContainerTheme" Value="{DynamicResource SegmentItemTheme}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="2" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>

  <Style Selector="Button">
    <Setter Property="Padding" Value="14,6" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Border.console">
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource RuleBrush}" />
  </Style>
  <Style Selector="GridSplitter.console">
    <Setter Property="Height" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ResizeDirection" Value="Rows" />
  </Style>
  <Style Selector="ListBox.log">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemContainerTheme" Value="{DynamicResource LogLineTheme}" />
  </Style>
  <Style Selector="Grid.log-row TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
  </Style>
  <Style Selector="Grid.log-row TextBlock.log-time">
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector="Grid.log-row SelectableTextBlock.log-message">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style Selector="Grid.log-row.warning TextBlock.log-level">
    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
  </Style>
  <Style Selector="Grid.log-row.error TextBlock.log-level">
    <Setter Property="Foreground" Value="{DynamicResource CriticalTextBrush}" />
  </Style>
  <Style Selector="Grid.log-row.error SelectableTextBlock.log-message">
    <Setter Property="Foreground" Value="{DynamicResource CriticalTextBrush}" />
  </Style>
  <Style Selector="Grid.log-row.debug SelectableTextBlock.log-message">
    <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="FontFamily" Value="{DynamicResource TextFont}" />
  </Style>
</Styles>
