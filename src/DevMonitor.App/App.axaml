<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DevMonitor.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Theme/Palette.axaml" />
        <ResourceInclude Source="/Theme/Controls.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#11707F" RegionColor="#F7F9FB" BaseHigh="#18212B" AltHigh="#F7F9FB" />
        <ColorPaletteResources x:Key="Dark" Accent="#4BB0BF" RegionColor="#1C232C" BaseHigh="#E3E8ED" AltHigh="#1C232C" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="/Theme/Styles.axaml" />
  </Application.Styles>
</Application>
