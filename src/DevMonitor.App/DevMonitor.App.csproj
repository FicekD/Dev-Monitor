<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>DevMonitor</AssemblyName>
    <ApplicationIcon>Assets\Icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DevMonitor.Core\DevMonitor.Core.csproj" />
    <ProjectReference Include="..\DevMonitor.Windows\DevMonitor.Windows.csproj" />
  </ItemGroup>
</Project>
